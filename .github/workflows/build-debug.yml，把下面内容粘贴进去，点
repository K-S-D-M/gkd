name: build-debug

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths-ignore:
      - 'LICENSE'
      - '*.md'

jobs:
  build-android-debug:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v6
        with:
          distribution: 'temurin'
          java-version: '21'
      - uses: gradle/actions/setup-gradle@v6
      - run: ./gradlew :gkd-android:assembleGkdDebug
      - uses: actions/upload-artifact@v7
        with:
          name: gkd-custom-debug-apk
          path: gkd-android/build/outputs/apk/gkd/debug/*.apk
